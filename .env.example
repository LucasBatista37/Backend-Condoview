# Ambiente: development | production
NODE_ENV=development
PORT=5000

# Banco de dados (preferencial)
MONGODB_URI=mongodb://localhost:27017/condoview
# Alternativa compatível com a configuração anterior:
# DB_USER=
# DB_PASS=
# DB_HOST=cluster0.xxxxx.mongodb.net

# Segredo para assinar sessões (mínimo 32 caracteres, aleatório). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Opcional: segredo separado para QR Codes de visitantes
INVITE_SECRET=

# URL pública da API (usada nos links de confirmação de e-mail)
PUBLIC_BASE_URL=https://sua-api.exemplo.com

# Pasta onde as imagens enviadas são gravadas (use um disco persistente em produção)
UPLOAD_DIR=./storage
MAX_UPLOAD_BYTES=5242880
CONDO_TIMEZONE=America/Sao_Paulo

# E-mail (SMTP). Em produção, sem SMTP o cadastro fica indisponível.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
REQUIRE_EMAIL_VERIFICATION=true

# Notificações push (opcional). JSON da conta de serviço do Firebase em uma linha
# ou caminho para o arquivo (nunca versionar).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Origens web autorizadas (separadas por vírgula). O app Android não precisa.
CORS_ORIGINS=
